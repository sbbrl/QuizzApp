# Database
# For local development with PostgreSQL, uncomment and update the following line:
DATABASE_URL="postgresql://user:password@localhost:5432/quizzapp"
# For Vercel deployment with Neon Postgres:
# DATABASE_URL is automatically set by Vercel through the Neon integration - no need to configure manually

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
