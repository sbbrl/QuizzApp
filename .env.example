# Database
# For local development with PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/quizzapp"
# For Neon Postgres (Vercel):
# DATABASE_URL will be automatically set by Vercel from Neon integration
DATABASE_URL="postgresql://user:password@localhost:5432/quizzapp"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
